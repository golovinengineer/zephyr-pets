/ {
	aliases {
		dht0 = &aht20;
	};
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart0; // Optional, for MCUboot or DFU
        zephyr,display = &ssd1306_ssd1306_128x64;
	};
};

 &i2c1 {
	status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

	aht20: aht20@38 {
		compatible = "aosong,aht20";
		reg = <0x38>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

    ht16k33@70 {
		compatible = "holtek,ht16k33";
		reg = <0x70>;
		/* Uncomment to use IRQ instead of polling: */
		/* irq-gpios = <&gpio1 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; */

		kscan-input {
			compatible = "zephyr,kscan-input";
		};
	};
    ssd1306_ssd1306_128x64: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x62>;
	};
};

&zephyr_udc0 {
    status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Zephyr USB CDC-ACM";
	};
};
